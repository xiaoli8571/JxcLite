@using Known.Components
@using AntDesign
@inherits BaseForm<ProcessInfo>

<Tabs Animated>
    <ChildContent>
        <TabPane Key="BizInfo" Tab="单据信息">
            <AntForm TItem="ProcessInfo" Form="Model" ShowAction>
                <ChildContent>
                    <AntRow>
                        <DataItem Span="24" Label="加工工厂">
                            <AntAutoComplete @bind-Value="@context.Factory" OnSearch="OnSearchFactory" Placeholder="选择供应商或手动输入" />
                        </DataItem>
                    </AntRow>
                    <AntRow>
                        <DataItem Span="12" Label="加工厂单号">
                            <AntInput @bind-Value="@context.FactoryNo" />
                        </DataItem>
                        <DataItem Span="12" Label="下单日期">
                            <AntDatePicker @bind-Value="@context.BillDate" />
                        </DataItem>
                    </AntRow>
                    <AntRow>
                        <DataItem Span="24">
                            <div style="background:#f0f0f0;text-align:center;font-weight:bold;padding:4px;border-radius:4px;">加工资料</div>
                        </DataItem>
                    </AntRow>
                    <AntRow>
                        <DataItem Span="8" Label="品名规格">
                            <AntInput @bind-Value="@context.GoodsSpec" />
                        </DataItem>
                        <DataItem Span="8" Label="胚布幅宽">
                            <AntInput @bind-Value="@context.ClothWidth" />
                        </DataItem>
                        <DataItem Span="8" Label="颜色">
                            <AntInput @bind-Value="@context.Color" />
                        </DataItem>
                    </AntRow>
                    <AntRow>
                        <DataItem Span="12" Label="投坯数量Y">
                            <AntInput @bind-Value="@context.InputQty" />
                        </DataItem>
                        <DataItem Span="12" Label="要求交期">
                            <AntDatePicker @bind-Value="@context.DeliveryDate" />
                        </DataItem>
                    </AntRow>
                    <AntRow>
                        <DataItem Span="24">
                            <div style="background:#f0f0f0;text-align:center;font-weight:bold;padding:4px;border-radius:4px;">加工工艺要求</div>
                        </DataItem>
                    </AntRow>
                    <AntRow>
                        <DataItem Span="8" Label="主灯">
                            <AntInput @bind-Value="@context.MainLight" />
                        </DataItem>
                        <DataItem Span="8" Label="辅灯">
                            <AntInput @bind-Value="@context.AuxLight" />
                        </DataItem>
                        <DataItem Span="8" Label="对色色卡">
                            <AntInput @bind-Value="@context.ColorCard" />
                        </DataItem>
                    </AntRow>
                    <AntRow>
                        <DataItem Span="6" Label="干摩擦牢度(级)">
                            <AntInput @bind-Value="@context.DryRubbing" />
                        </DataItem>
                        <DataItem Span="6" Label="湿摩擦牢度(级)">
                            <AntInput @bind-Value="@context.WetRubbing" />
                        </DataItem>
                        <DataItem Span="6" Label="PH值">
                            <AntInput @bind-Value="@context.PhValue" />
                        </DataItem>
                        <DataItem Span="6" Label="日晒牢度(级)">
                            <AntInput @bind-Value="@context.SunRubbing" />
                        </DataItem>
                    </AntRow>
                    <AntRow>
                        <DataItem Span="6" Label="耐黄度(级)">
                            <AntInput @bind-Value="@context.YellowResist" />
                        </DataItem>
                        <DataItem Span="6" Label="皂洗牢度(级)">
                            <AntInput @bind-Value="@context.SoapRubbing" />
                        </DataItem>
                        <DataItem Span="6" Label="本光">
                            <Checkbox @bind-Value="@context.BenGuangChecked" />
                        </DataItem>
                        <DataItem Span="6" Label="丝光">
                            <Checkbox @bind-Value="@context.SiGuangChecked" />
                        </DataItem>
                    </AntRow>
                    <AntRow>
                        <DataItem Span="6" Label="硫化">
                            <Checkbox @bind-Value="@context.LiuHuaChecked" />
                        </DataItem>
                        <DataItem Span="6" Label="活性">
                            <Checkbox @bind-Value="@context.HuoXingChecked" />
                        </DataItem>
                        <DataItem Span="6" Label="碧纹洗水">
                            <Checkbox @bind-Value="@context.BiJiXiShuiChecked" />
                        </DataItem>
                        <DataItem Span="6" Label="涂料">
                            <Checkbox @bind-Value="@context.TuLiaoChecked" />
                        </DataItem>
                    </AntRow>
                    <AntRow>
                        <DataItem Span="6" Label="预缩">
                            <Checkbox @bind-Value="@context.YuSuoChecked" />
                        </DataItem>
                        <DataItem Span="6" Label="成品宽幅">
                            <AntInput @bind-Value="@context.FinishWidth" />
                        </DataItem>
                        <DataItem Span="12"></DataItem>
                    </AntRow>
                    <AntRow>
                        <DataItem Span="24" Label="备注">
                            <AntTextArea @bind-Value="@context.Note" Rows="4" />
                        </DataItem>
                    </AntRow>
                    <AntRow>
                        <DataItem Span="12" Label="审核">
                            <AntInput @bind-Value="@context.Auditor" />
                        </DataItem>
                        <DataItem Span="12" Label="制单">
                            <AntInput @bind-Value="@context.Maker" />
                        </DataItem>
                    </AntRow>
                </ChildContent>
            </AntForm>
        </TabPane>
        <TabPane Key="Print" Tab="打印预览">
            <div style="display:flex;gap:8px;margin-bottom:8px;justify-content:flex-end;">
                <KButton Name="保存并刷新预览" OnClick="OnRefreshPreview" />
                <KButton Name="打印" OnClick="OnPrint" />
            </div>
            <div style="background:#f5f5f5;padding:12px;border-radius:6px;">
                <div style="background:#fff;margin:0 auto;box-shadow:0 2px 8px rgba(0,0,0,.15);overflow:auto;">
                    <ProcessPrint Model="Model.Data" />
                </div>
            </div>
        </TabPane>
    </ChildContent>
</Tabs>
